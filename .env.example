# Digital Asset Center - ortam değişkenleri ÖRNEĞİ. Gerçek değerleri Render > Environment bölümüne girin; bu dosyaya ASLA gerçek sır yazmayın.
NODE_ENV=production
PORT=3000
SITE_URL=https://dac-web-tfqf.onrender.com
ALLOWED_ORIGINS=

# --- Firebase (zorunlu: giriş, veritabanı, admin paneli) ---
# Hizmet hesabı JSON'unun TAMAMI tek satır olarak. Tarayıcıya gönderilmez.
FIREBASE_SERVICE_ACCOUNT=
# Tarayıcı için herkese açık web yapılandırması (gizli değildir)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
VERIFY_REVOKED=true

# --- Yönetici paneli ---
# İlk yönetici(ler): virgülle ayrılmış Firebase UID'leri ve/veya DOĞRULANMIŞ e-postalar. Sonrası panelden verilir.
ADMIN_UIDS=
ADMIN_EMAILS=
ADMIN_IP_RATE_LIMIT=120
ADMIN_USER_RATE_LIMIT=240
ADMIN_WRITE_RATE_LIMIT=40
ADMIN_USER_SCAN_CAP=20000

# --- Toplu tarama kuyruğu (Firestore: scanJobs, scanJobItems) ---
JOB_CONCURRENCY=3
JOB_PER_USER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=30000
JOB_MAX_ITEMS=1000
JOB_MAX_ACTIVE_PER_USER=5
JOB_MAX_QUEUED_PER_USER=3000
JOB_WRITE_RATE_LIMIT=20
JOB_READ_RATE_LIMIT=600
SCAN_TIMEOUT_MS=75000

# --- Otomatik tarama / dış cron (Render ücretsiz plan uyuyorsa cron-job.org ile /api/cron/scan çağırın) ---
AUTO_SCAN=true
CRON_SECRET=

# --- Ödeme (yapılandırılmadıysa devre dışı görünür) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- AI: ŞİMDİLİK KAPALI. Gemini anahtarı istenmez ve okunmaz. ---
AI_ENABLED=false
AI_PROVIDER=gemini

# --- Yalnızca geliştirme ---
# DEV_AUTH_BYPASS=true   (üretimde asla)
