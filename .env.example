# Digital Asset Center - ortam değişkenleri ÖRNEĞİ. Gerçek değerleri Render > Environment bölümüne girin; bu dosyaya ASLA gerçek sır yazmayın.
NODE_ENV=production
PORT=3000
SITE_URL=https://dac-web-tfqf.onrender.com
ALLOWED_ORIGINS=

# --- Firebase (zorunlu: giriş, veritabanı, admin paneli) ---
# Hizmet hesabı JSON'unun TAMAMI tek satır olarak. Tarayıcıya gönderilmez.
FIREBASE_SERVICE_ACCOUNT=
# Tarayıcı için herkese açık web yapılandırması (gizli değildir)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
VERIFY_REVOKED=true

# --- Yönetici paneli ---
# İlk yönetici(ler): virgülle ayrılmış Firebase UID'leri ve/veya DOĞRULANMIŞ e-postalar. Sonrası panelden verilir.
ADMIN_UIDS=
ADMIN_EMAILS=
ADMIN_IP_RATE_LIMIT=120
ADMIN_USER_RATE_LIMIT=240
ADMIN_WRITE_RATE_LIMIT=40
ADMIN_USER_SCAN_CAP=20000

# --- Toplu tarama kuyruğu (Firestore: scanJobs, scanJobItems) ---
JOB_CONCURRENCY=3
JOB_PER_USER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=30000
JOB_MAX_ITEMS=1000
JOB_MAX_ACTIVE_PER_USER=5
JOB_MAX_QUEUED_PER_USER=3000
JOB_WRITE_RATE_LIMIT=20
JOB_READ_RATE_LIMIT=600
SCAN_TIMEOUT_MS=75000

# --- Otomatik tarama / dış cron (Render ücretsiz plan uyuyorsa cron-job.org ile /api/cron/scan çağırın) ---
AUTO_SCAN=true
CRON_SECRET=

# --- Ödeme (yapılandırılmadıysa devre dışı görünür) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- AI: ŞİMDİLİK KAPALI. Gemini anahtarı istenmez ve okunmaz. ---
AI_ENABLED=false
AI_PROVIDER=gemini

# --- V13.3: e-posta (Resend) ---
# RESEND_API_KEY=
# MAIL_FROM="DAC <bildirim@alanadiniz.com>"
# SITE_URL=https://alanadiniz.com
# --- V13.3: alarm kanalları (hepsi isteğe bağlı) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...   (https; {"text": "..."} gönderir)
# ALERT_EMAIL=
# ALERT_5XX_PERCENT=10
# ALERT_MIN_REQUESTS=20
# --- V13.3: yedek (Firestore -> GCS) ---
# BACKUP_BUCKET=
# FIREBASE_PROJECT_ID=
# --- V13.3: yönetici 2FA ve CAPTCHA ---
# ADMIN_REQUIRE_2FA=true        (önce Yönetici > Güvenlik'ten kurulum yapın, sonra açın)
# ADMIN_2FA_SECRET=             (rastgele uzun değer; çoklu sunucuda jeton imzası için)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TRIAL_PEPPER=                 (deneme özeti tuzu; bir kez belirleyin, sonra değiştirmeyin)

# --- Yalnızca geliştirme ---
# DEV_AUTH_BYPASS=true   (üretimde asla)

# --- Korumalı hedefler (blocklist.js): devlet/kamu, büyük platformlar ve DAC'ın kendi alan adı HİÇBİR türde taranamaz ---
# OWN_DOMAINS=dacweb.tr,www.dacweb.tr        (DAC'ın kendi alan adları; dacweb.tr zaten koddadır, SITE_URL de otomatik eklenir)
# BLOCKED_DOMAINS=ornek1.com,ornek2.com      (ek yasaklı alan adları; alt alan adları dahil)
# BLOCKED_ALLOW=                             (yalnızca acil istisna, tam eşleşme; kamu ve dacweb.tr için istisna VERİLEMEZ)
# BLOCKED_ATTEMPT_LIMIT=6                    (10 dk içinde bu kadar yasaklı denemeden sonra kullanıcı geçici engellenir)
# BLOCK_STRICT_PLATFORMS=false               (true: Kod Deposu/Mobil Uygulama türlerinde github.com / Play Store / App Store istisnası da kapanır)
# ADMIN_USER_ASSET_CAP=500                   (yönetici kullanıcı detayında gösterilecek en çok varlık)
