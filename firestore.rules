rules_version = '2';
// Site Firestore'a doğrudan erişmez; tüm okuma/yazma sunucuda Admin SDK ile yapılır
// (Admin SDK kurallardan etkilenmez). Bu yüzden istemci erişimi tamamen kapalı olmalı.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
