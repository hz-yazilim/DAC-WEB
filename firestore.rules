rules_version = '2';

// Firebase Console'da yayınlı olan kuralın aynısıdır (varlik-operasyonlari-ed334).
// Tarayıcıdan Firestore'a doğrudan erişim KAPALI: uygulama istemcide Firestore SDK'sı kullanmaz.
// Tüm okuma/yazma, Firebase ID token'ı doğrulayan sunucu (Admin SDK) üzerinden yapılır.
// Admin SDK bu kuralları atladığı için sahiplik/kota/yetki kontrolleri sunucu kodundadır (security.js, payments.js, user-state.js).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
